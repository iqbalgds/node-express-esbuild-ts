{
  "name": "express-esbuild-ts",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build:client": "esbuild src/client/main.ts --bundle --outdir=public/build --platform=browser --target=es2017 --sourcemap",
    "build:client:watch": "esbuild src/client/main.ts --bundle --outdir=public/build --platform=browser --target=es2017 --sourcemap --watch",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
